# Generate a random secret with at least 32 characters. Keep it private.
JWT_SECRET=

# Configure both Apps Script values for the production database and Google Drive uploads.
APPS_SCRIPT_URL=
APPS_SCRIPT_SECRET=

# Supabase B2B portal. The URL and anon key are public client identifiers, not privileged secrets.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Local demo seed only. Never expose the service-role key to client code or deploy it to the frontend.
SUPABASE_SERVICE_ROLE_KEY=
MAN3_DEMO_SEED=false
MAN3_DEMO_ADMIN_PASSWORD=
MAN3_DEMO_MITRA_PASSWORD=
